pkgname=lensdesk
pkgver=0.1.0
pkgrel=1
pkgdesc='Native visual search and local text capture panel for Omarchy (preview)'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal' 'grim' 'omarchy')
optdepends=('tesseract: local text extraction' 'tesseract-data-eng: English text recognition')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lensdesk "$pkgdir/usr/bin/lensdesk"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/lensdesk.desktop "$pkgdir/usr/share/applications/lensdesk.desktop"
  install -Dm644 ../share/icons/google-lens.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lensdesk.svg"
}
