@@ -210,6 +210,93 @@ function formatRate(bytesPerSecond, formatNumber) {
   return formatBytes(bytesPerSecond, formatNumber) + "/s"
 }
 
+function formatBarRate(bytesPerSecond, formatNumber) {
+  var fmt = typeof formatNumber === "function" ? formatNumber : function(v, d) { return Number(v).toFixed(d) }
+  var units = ["B/s", "K/s", "M/s", "G/s", "T/s"]
+  var value = Math.max(0, Number(bytesPerSecond) || 0)
+  var unit = 0
+  while (value >= 1000 && unit < units.length - 1) {
+    value /= 1000
+    unit++
+  }
+  var decimals = unit === 0 ? 0 : (value < 10 ? 1 : 0)
+  // Prevent rounding from spilling into an extra digit (10.0 or 1000).
+  if (decimals === 1 && Number(value.toFixed(1)) >= 10) decimals = 0
+  if (decimals === 0 && Math.round(value) >= 1000 && unit < units.length - 1) {
+    value /= 1000
+    unit++
+    decimals = 1
+  }
+  return fmt(value, decimals) + " " + units[unit]
+}
+
+// Extract cumulative rx/tx byte counters for `iface` from /proc/net/dev.
+function parseProcNetDev(rawText, iface) {
+  if (!iface) return null
+  var lines = String(rawText || "").split("\n")
+  for (var i = 0; i < lines.length; i++) {
+    var line = lines[i]
+    var colon = line.indexOf(":")
+    if (colon < 0) continue
+    if (line.slice(0, colon).trim() !== iface) continue
+    var fields = line.slice(colon + 1).trim().split(/\s+/)
+    if (fields.length < 9) return null
+    var rx = Number(fields[0])
+    var tx = Number(fields[8])
+    if (!isFinite(rx) || rx < 0 || !isFinite(tx) || tx < 0) return null
+    return { rx: rx, tx: tx }
+  }
+  return null
+}
+
+// Compute live rx/tx bytes/sec from consecutive counter snapshots.
+// Stale intervals (> 10s, e.g. suspend/resume) or counter resets re-baseline.
+function computeLiveRate(prevSample, nextSample, nowMs) {
+  if (!nextSample || !isFinite(nowMs) || nowMs <= 0) return null
+  var sample = { rx: nextSample.rx, tx: nextSample.tx, ms: nowMs }
+  if (!prevSample || !isFinite(prevSample.ms) || prevSample.ms <= 0) {
+    return { sample: sample, rxRate: 0, txRate: 0, ready: false }
+  }
+  var elapsedMs = nowMs - prevSample.ms
+  if (elapsedMs <= 0 || elapsedMs > 10000 || nextSample.rx < prevSample.rx || nextSample.tx < prevSample.tx) {
+    return { sample: sample, rxRate: 0, txRate: 0, ready: false }
+  }
+  return {
+    sample: sample,
+    rxRate: (nextSample.rx - prevSample.rx) * 1000 / elapsedMs,
+    txRate: (nextSample.tx - prevSample.tx) * 1000 / elapsedMs,
+    ready: true
+  }
+}
+
+function normalizeSpeedMode(mode) {
+  var m = String(mode || "Both").toLowerCase()
+  if (m === "download" || m === "down") return "Download"
+  if (m === "icon only" || m === "icon") return "Icon only"
+  return "Both"
+}
+
+function nextSpeedMode(mode) {
+  var cur = normalizeSpeedMode(mode)
+  if (cur === "Both") return "Download"
+  if (cur === "Download") return "Icon only"
+  return "Both"
+}
+
+function barSpeedText(rxRate, txRate, mode, connected, formatNumber) {
+  var m = normalizeSpeedMode(mode)
+  if (!connected || m === "Icon only") return ""
+  if (m === "Download") return "↓ " + formatBarRate(rxRate, formatNumber)
+  return "↓ " + formatBarRate(rxRate, formatNumber) + "  ↑ " + formatBarRate(txRate, formatNumber)
+}
+
+function verticalSpeedLines(rxRate, txRate, mode, connected, formatNumber) {
+  var m = normalizeSpeedMode(mode)
+  if (!connected || m === "Icon only") return [BAR_ICON]
+  if (m === "Download") return ["↓", formatBarRate(rxRate, formatNumber)]
+  return ["↓", formatBarRate(rxRate, formatNumber), "↑", formatBarRate(txRate, formatNumber)]
+}
+
 var LIMIT_MAX = 1e15
 
