+test("parseProcNetDev and computeLiveRate handle snapshots and edge cases", () => {
+  const procSample = [
+    "Inter-|   Receive                                                |  Transmit",
+    " face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed",
+    "    lo: 6131211    9973    0    0    0     0          0         0  6131211    9973    0    0    0     0       0          0",
+    "  wlo1: 14095736507 11291306    0 1396    0     0          0         0 989726177 2612158    0   42    0     0       0          0"
+  ].join("\n")
+
