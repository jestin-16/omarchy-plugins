diff --git a/lib/usage.sh b/lib/usage.sh
index 9cf931f..491e88d 100644
--- a/lib/usage.sh
+++ b/lib/usage.sh
@@ -9,7 +9,7 @@
 # exactly that record and nothing else; so does this page. Recomputing any of
 # it here would be a second answer to a question that already has one.
 
-USAGE_PROVIDERS=(claude codex fireworks)
+USAGE_PROVIDERS=(agy claude codex fireworks)
 
 # The provider this machine actually sends agent work to, which the menu
 # already tracks as the default agent.
@@ -17,6 +17,7 @@ usage_provider() {
   local current
   current=$(agents_state | jq -r '.current // ""' 2>/dev/null)
   case ${current:-} in
+    *agy*|*antigravity*) printf 'agy' ;;
     *claude*) printf 'claude' ;;
     *codex*) printf 'codex' ;;
     *fireworks*) printf 'fireworks' ;;
@@ -41,6 +42,11 @@ usage_first_ready() {
 usage_record() {
   local provider=${1:-}
   [[ -n $provider ]] || { echo '{}'; return; }
+  local cached="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage/$provider.json"
+  if [[ -f $cached ]]; then
+    cat "$cached"
+    return
+  fi
   command -v "omarchy-agent-usage-$provider" >/dev/null 2>&1 || { echo '{}'; return; }
   # A longer bound than the other readers: this one can be reading a year of
   # transcripts on a first run.
@@ -100,7 +106,7 @@ usage_cmd() {
       local provider=${1:-}
       [[ -n $provider ]] || provider=$(usage_provider)
       [[ -n $provider ]] || die "no agent usage provider on this machine"
-      timeout 60 "omarchy-agent-usage-$provider" --force >/dev/null 2>&1 ;;
+      timeout 60 omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 || timeout 60 "omarchy-agent-usage-$provider" --force >/dev/null 2>&1 ;;
     *) die "usage: omacontrol usage poll|refresh [provider]" ;;
   esac
 }
