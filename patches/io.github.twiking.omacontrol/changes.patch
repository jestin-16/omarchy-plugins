diff --git a/lib/state.sh b/lib/state.sh
index 205eabb..b0cd1f6 100644
--- a/lib/state.sh
+++ b/lib/state.sh
@@ -50,7 +50,7 @@ state_changed() {
 # or the other depending on which read answered last.
 BAR_STATE_JQ='{
