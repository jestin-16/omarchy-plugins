#!/usr/bin/python3
"""Desktop frontend for the fixed system cooling controller."""
import json
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time

HELPER = Path('/usr/local/libexec/msi-cooling-controller')
STATUS = Path('/run/msi-cooling/status.json')
MODES = ('quiet', 'balanced', 'dynamic', 'boost')
UI_STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'msi-cooling-ui'
MODE_DETAILS = {
    'quiet': 'Low power · automatic fans',
    'balanced': 'Balanced power · automatic fans',
    'dynamic': 'Power and cooling adjust to temperature',
    'boost': 'Maximum cooling · louder fans',
}


def notify(message):
    # The caller holds the UI lock: preserve notification order across keypresses.
    try:
        id_file = UI_STATE / 'notification-id'
        try:
            previous = int(id_file.read_text().strip())
            # Reuse only a recent toast, not an ID from an earlier shell session.
            age = time.time() - id_file.stat().st_mtime
            if not 0 <= previous <= 4294967295 or not 0 <= age <= 5:
                previous = 0
        except (OSError, ValueError):
            previous = 0
        result = subprocess.run(['/usr/bin/omarchy', 'notification', 'send', '--app-name', 'MSI Cooling',
                                 '-u', 'normal', '-t', '2500', '-r', str(previous), '-p',
                                 'Cooling mode', message],
                                capture_output=True, text=True, timeout=4)
        if result.returncode == 0:
            new_id = int(result.stdout.strip())
            if 0 < new_id <= 4294967295:
                id_file.write_text(str(new_id) + '\n')
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass


def status():
    value = json.loads(STATUS.read_text())
    if time.time() - value['updated'] > 20:
        raise RuntimeError('Cooling service status is stale. Check: systemctl status msi-cooling')
    if value.get('error'):
        raise RuntimeError(value['error'])
    return value


def describe(value):
    temp = value.get('temperature')
    speed = value.get('rpm')
    return (f"{value['mode'].title()} — {value['stage']}\n"
            f"{f'{temp:.0f}°C' if temp is not None else 'Temperature unavailable'} · "
            f"{f'{speed:.0f} RPM' if speed is not None else 'RPM unavailable'}\n"
            f"{value['profile']} · Boost {'ON (louder)' if value['boost'] else 'OFF'}")


def perform():
    command = sys.argv[1] if len(sys.argv) == 2 else 'status' if len(sys.argv) == 1 else ''
    if command not in (*MODES, 'toggle', 'cycle', 'status'):
        raise ValueError('Usage: msi-cooling [quiet|balanced|dynamic|boost|toggle|cycle|status]')
    if not HELPER.exists():
        # Keep the original shortcut working until the new service is installed.
        if command == 'toggle':
            result = subprocess.run(['/usr/bin/pkexec', '/usr/local/libexec/msi-cooler-boost-toggle'],
                                    capture_output=True, text=True, check=True)
            message = 'Cooler Boost: ' + result.stdout.strip()
            print(message)
            notify(message)
            return
        raise RuntimeError('Install cooling modes: bash ~/.local/share/msi-cooling/setup.sh')
    if command != 'status':
        selected = subprocess.run(['/usr/bin/pkexec', str(HELPER), command],
                                  capture_output=True, text=True)
        if selected.returncode:
            raise RuntimeError(selected.stderr.strip() or 'Cooling mode could not be selected')
        mode = selected.stdout.strip()
        if mode not in MODES:
            raise RuntimeError('The cooling controller returned an invalid mode')
        # Confirm the saved selection immediately. Hardware follows on the next
        # controller tick; old RPM/temperature samples do not describe this selection.
        message = f'{mode.title()} selected\n{MODE_DETAILS[mode]}'
    else:
        value = status()
        message = describe(value)
    print(message)
    notify(message)


def main():
    UI_STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Serialize just selection + notification, with no wait for sensor polling.
    # Every press still advances the cycle; older invocations cannot overwrite
    # a newer selection or produce a delayed timeout toast.
    with (UI_STATE / 'command.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            perform()
        except Exception as error:
            message = str(error)
            print(message, file=sys.stderr)
            notify(message)
            return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
